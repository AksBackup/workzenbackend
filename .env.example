PORT=4000

# Database - works with Aiven (temporary, free) or Oracle MySQL HeatWave
# (target, once available) without code changes, just swap these values.
DB_HOST=your-db-host.example.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=changeme
DB_NAME=hrms
DB_SSL=true
# CA certificate for the SSL handshake - use ONE of these two, not both:
#   - Render (or anywhere you can't drop in a file): paste the entire
#     contents of the provider's .pem file as this env var's value.
DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
#   - Local dev: point at the downloaded file instead, and leave DB_SSL_CA unset.
# DB_SSL_CA_PATH=./aiven-ca.pem

# Firebase Admin SDK - use ONE of these two, not both:
#   - Local dev: point at the downloaded JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
#   - Render (or anywhere you can't drop in a file): paste the entire JSON
#     contents as the value of this env var instead, and leave the PATH
#     variable above unset.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Internal admin key-generation panel (public/index.html)
# This protects the license-generation tool only - it is NOT customer auth.
PANEL_SECRET=changeme-strong-random-string
